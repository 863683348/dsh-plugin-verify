{
  "name": "dsh-plugin-verify",
  "version": "1.1.2",
  "description": "Verification toolkit for DeepSeek Harness agents: evidence-based claim checking against workspace files with line citations, config validation (JSON/YAML), HTTP URL status checks, npm package checks, GitHub repo submission-readiness checks, and batch verification with bounded concurrency and per-result confidence grading",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./verify": "./lib/verify.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "test": "node test/batch.test.mjs && node test/verify.test.mjs",
    "prepublishOnly": "node test/batch.test.mjs && node test/verify.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "verify",
    "validation",
    "claim",
    "check",
    "audit",
    "npm",
    "github"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/863683348/dsh-plugin-verify.git"
  },
  "homepage": "https://github.com/863683348/dsh-plugin-verify#readme",
  "bugs": {
    "url": "https://github.com/863683348/dsh-plugin-verify/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
